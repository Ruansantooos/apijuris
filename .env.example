ENVIRONMENT=production

POSTGRES_USER=eproc
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=eproc_tracker

# Obrigatório: sem ele a API não sobe. Usa o nome do serviço "db" do compose.
DATABASE_URL=postgresql+psycopg://eproc:troque-esta-senha@db:5432/eproc_tracker

# Ligue se o Postgres estiver fora da VPS (banco gerenciado). No compose fica false.
DB_REQUIRE_SSL=false

# Origens de navegador que podem chamar a API, em JSON. Vazio = nenhuma.
CORS_ORIGINS=[]

SCRAPER_TIMEOUT_SECONDS=25
SCRAPER_MAX_CONCURRENCY=1
SCRAPER_USE_XVFB=true
LOG_LEVEL=INFO
